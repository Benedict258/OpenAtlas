{
  "name": "openatlas-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "sdk",
    "gateway",
    "starter-kits/citizen-services",
    "starter-kits/education",
    "starter-kits/customer-service",
    "site"
  ],
  "scripts": {
    "build": "npm run build -w @openatlas/sdk",
    "test": "npm test -w @openatlas/sdk",
    "dev:mock-backend": "node scripts/dev/mock-backend/server.mjs",
    "dev:gateway": "npm run dev -w openatlas-gateway",
    "dev:site": "npm run dev -w openatlas-site"
  }
}
