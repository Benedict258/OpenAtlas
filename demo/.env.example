# Copy to .env.local (development) and set the same variables in the host (production).
# Nothing here is a real secret; real values never belong in the repo.

# The demo app's own gateway key. Server-side only: never exposed to the browser.
OPENATLAS_API_KEY=

# Optional. Leave unset to use the SDK's default hosted gateway.
OPENATLAS_BASE_URL=

# Visitors must type this passcode on /unlock to use the app.
DEMO_PASSCODE=

# Random long string used to sign the unlock cookie. Generate with e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# 1 = mock mode for building the UI while the GPU is off. Off by default.
# NEVER set this for the deployed app or while recording the demo video.
DEMO_MOCK=
