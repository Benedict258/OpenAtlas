{
  "name": "openatlas-gateway",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --port 8787",
    "db:init:local": "wrangler d1 execute openatlas --local --file=schema.sql",
    "db:init:remote": "wrangler d1 execute openatlas --remote --file=schema.sql",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261002.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
