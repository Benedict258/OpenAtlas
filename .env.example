# Copy to .env (gitignored) for the operator scripts: node --env-file=.env <script>
# See docs/deploy-your-own.md for where each value comes from.

# Hugging Face read token, after accepting the terms on the five NCAIR1 repos
HF_TOKEN=hf_...
# The backend's key: any random string of 16+ characters (e.g. `openssl rand -hex 24`).
# The GPU server calls it BACKEND_API_KEY; the gateway and these scripts call it NATLAS_API_KEY.
NATLAS_API_KEY=

# Your gateway, e.g. https://<name>.<subdomain>.workers.dev or a custom domain
OPENATLAS_BASE_URL=
# The gateway's admin token (the ADMIN_TOKEN Worker secret), for scripts/keys.mjs and scripts/key-requests.mjs
OPENATLAS_ADMIN_TOKEN=
# An API key issued by your gateway, for sdk/examples/quickstart.mjs and scripts/smoke-gateway.mjs
OPENATLAS_API_KEY=
OPENATLAS_TEST_KEY=

# Cloudflare API token (Workers Scripts: Edit, D1: Edit, Account Settings: Read), used by wrangler
CLOUDFLARE_API_TOKEN=
